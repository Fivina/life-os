APP_ENV=development
DATABASE_URL=
DEVELOPMENT_AUTH_ENABLED=true
DEVELOPMENT_AUTH_TOKEN=
SUPABASE_PROJECT_URL=
# HS256 JWT signing secret. Do not use a Supabase service/secret API key here.
SUPABASE_JWT_SECRET=
# Optional exact issuer override; otherwise SUPABASE_PROJECT_URL derives it.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
AUTHORIZED_AUTH_SUBJECTS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_BASE_URL=
LOG_LEVEL=INFO
DEPLOYMENT_VERSION=2.0
PLANNER_VERSION=v1.5-domain-intelligence
AGENT_PROMPT_VERSION=v1.5
LEARNING_MODEL_VERSION=v0
AI_ENABLED=true
# SDK runtime covers Self Core and interactive specialists; legacy remains the rollback.
AGENT_RUNTIME=legacy
AGENT_PROVIDER=openai
OPENAI_API_KEY=
# Set explicit Responses-compatible models before enabling sdk.
AGENT_MODEL_ECONOMY=
AGENT_MODEL_FAST=
AGENT_MODEL_REASONING=
AGENT_MAX_TURNS=6
AGENT_TRACE_EXPORT_ENABLED=false
AI_PROVIDER=fake
AI_MODEL_ECONOMY=life-os-fake-standard
AI_MODEL_FAST=life-os-fake-standard
AI_MODEL_REASONING=life-os-fake-strong
AI_MODEL_EMBEDDING=life-os-fake-embedding
AI_MODEL_VISION=life-os-fake-vision
AI_MODEL_IMAGE=life-os-fake-image
AI_MODEL_PRICING_JSON={}
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=15
AI_MONTHLY_BUDGET_EUR=12
AI_WARNING_THRESHOLD_EUR=10
AI_ECONOMY_THRESHOLD_EUR=10.5
AI_RESTRICT_OPTIONAL_THRESHOLD_EUR=11
AI_CONTEXT_MAX_CHARS=24000
RESPONSE_COMPOSER_ENABLED=true
RESPONSE_COMPOSER_GENERATIVE_ENABLED=true
REALTIME_STATE_ENABLED=true
REALTIME_POLL_SECONDS=1.0
REALTIME_HISTORY_LIMIT=250
DECISION_INFRA_ENABLED=false
DECISION_PROVIDER=fake
DECISION_TRACING_ENABLED=true
DECISION_POLICY_VERSION=decision-policy-v1
# Decision infrastructure remains off until hosted credentials are ready; AUTO prefers Jev when enabled.
DECISION_ROUTING_MODE=AUTO
DECISION_ROUTING_POLICY_VERSION=decision-routing-v1
DECISION_CONFIDENCE_THRESHOLDS_JSON={"attention":0.72,"context_relevance":0.70,"contributor_activation":0.68,"curiosity":0.72,"memory":0.72,"prospective":0.72,"default":0.72}
# Optional local-only provider. Installing requirements-laya.txt may download model weights on first enabled use.
LAYA_ENABLED=false
LAYA_MODEL=auto
LAYA_DEVICE=auto
LAYA_CACHE_PATH=
LAYA_MAX_CHOICES=16
LAYA_MAX_CONTEXT_BYTES=16384
# Optional external decision provider. Its per-user credential is stored in Supabase Vault, not this file.
JEV_ENABLED=true
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_MAX_RETRIES=1
JEV_DAILY_BUDGET_EUR=1.0
DECISION_SHADOW_ENABLED=false
DECISION_SHADOW_PROVIDER=laya_local
DECISION_SHADOW_SAMPLE_RATE=0.05
DECISION_SHADOW_FAMILIES=
DECISION_SHADOW_DAILY_BUDGET_EUR=0.25
# Benchmark/live-smoke only. Leave false during normal tests.
DECISION_LIVE_PROVIDER_TESTS=false
COGNITIVE_WORKSPACE_ENABLED=false
ATTENTION_POLICY_ENABLED=false
INTELLIGENCE_FEEDBACK_ENABLED=false
FEEDBACK_MAX_QUESTIONS=4
CONVERSATION_COMPACTION_THRESHOLD=24
CONVERSATION_RECENT_WINDOW=10
EMBEDDING_DIMENSIONS=768
MEMORY_RETRIEVAL_LIMIT=6
EPISODE_RETRIEVAL_LIMIT=3
PATTERN_CONTEXT_LIMIT=6
MEMORY_CONTEXT_MAX_CHARS=6000
MEMORY_MIN_RELEVANCE=0.30
MEMORY_SEMANTIC_MERGE_THRESHOLD=0.88
MEMORY_CANDIDATE_GATE_ENABLED=true
MEMORY_CONSOLIDATION_EVENT_THRESHOLD=3
MEMORY_CONSOLIDATION_LOOKBACK_HOURS=30
PLANNER_HORIZON_DAYS=10
PLANNER_SLOT_GRANULARITY_MINUTES=15
PLANNER_FREEZE_WINDOW_MINUTES=45
PLANNER_MAX_CANDIDATES=100
PLANNER_MAX_SLOTS_PER_CANDIDATE=96
PLANNER_CAPACITY_FLOOR=0.65
PLANNER_CAPACITY_CEILING=1.15
PLANNER_MORNING_HOUR=5
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_PATH=
MEDIA_MAX_UPLOAD_BYTES=10000000
FINANCE_DEFAULT_CURRENCY=EUR
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_SUBJECT=
PUSH_DELIVERY_MODE=mock
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF_SECONDS=60
OUTBOX_MAX_BACKOFF_SECONDS=3600

# v1.8C opportunity discovery. Missing credentials keep startup healthy.
OPPORTUNITY_DISCOVERY_ENABLED=true
OPPORTUNITY_DEFAULT_CITY=
OPPORTUNITY_DEFAULT_COUNTRY_CODE=
CHEF_INTENT_ENABLED=true
CHEF_INTENT_GENERATIVE_ENABLED=true
OPPORTUNITY_SOURCE_CADENCE_MINUTES=360
OPPORTUNITY_DISCOVERY_HORIZON_DAYS=30
OPPORTUNITY_MAX_RESULTS_PER_SOURCE=100
OPPORTUNITY_SOURCE_TIMEOUT_SECONDS=10
TICKETMASTER_API_KEY=
TICKETMASTER_API_BASE_URL=https://app.ticketmaster.com/discovery/v2
